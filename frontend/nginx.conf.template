# Rendered to /etc/nginx/conf.d/default.conf at container start; only ${BACKEND_URL} is
# substituted (the nginx image's envsubst only touches variables that are set).

# Guest links carry a secret token: keep it out of the access log (A12).
map $request_uri $loggable_uri {
    ~^/i/[^/?]+(?<rest>.*)$  /i/<token>$rest;
    default                  $request_uri;
}

log_format guestlist '$remote_addr [$time_local] "$request_method $loggable_uri" '
                     '$status $body_bytes_sent ${request_time}s';

server {
    listen 80;
    root /usr/share/nginx/html;
    access_log /dev/stdout guestlist;

    # Inherited by every location below that doesn't set add_header itself.
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # One domain, no CORS (A1). Host stays the backend's own name, which Container Apps needs.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have content hashes in their names.
    location /assets/ {
        expires max;
    }

    location = /index.html {
        expires -1;
    }

    # Client-side routes (/i/<token>, /admin/...) all serve the app.
    location / {
        try_files $uri /index.html;
    }
}
