# Copy to .env for `uv run` outside of compose.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://guestlist:guestlist@localhost:5432/guestlist
AUTH_DEV_BYPASS=true

# To try the real host login (Google, A28) instead, set AUTH_DEV_BYPASS=false and fill in the
# web OAuth client from Google Cloud. Its authorized redirect URIs must include
# http://localhost:8000/api/auth/google/callback (and :5173 for the Vite dev server).
# The secret stays in .env, which git ignores.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
