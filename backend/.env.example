# Copy to .env for `uv run` outside of compose.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://guestlist:guestlist@localhost:5432/guestlist
AUTH_DEV_BYPASS=true

# To try the real host login (Entra External ID, A27) instead, set AUTH_DEV_BYPASS=false and
# uncomment these. None of them is a secret. Entra only sends logins back to
# http://localhost:8000/ and http://localhost:5173/.
# OIDC_ISSUER=https://348c4042-e352-42a2-b36f-95c9dfe35439.ciamlogin.com/348c4042-e352-42a2-b36f-95c9dfe35439/v2.0
# OIDC_AUDIENCE=975c8cb7-df04-4de9-b3c9-afcfc4f93fbb
# OIDC_JWKS_URL=https://guestlistentra.ciamlogin.com/348c4042-e352-42a2-b36f-95c9dfe35439/discovery/v2.0/keys
# OIDC_REQUIRED_SCOPE=access
# OIDC_AUTHORITY=https://guestlistentra.ciamlogin.com/348c4042-e352-42a2-b36f-95c9dfe35439/v2.0
# OIDC_CLIENT_ID=21e3f254-5c5c-43fb-9bff-247dd87a247f
# OIDC_CLIENT_SCOPE=api://975c8cb7-df04-4de9-b3c9-afcfc4f93fbb/access
